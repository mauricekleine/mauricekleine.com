{
  "name": "@mauricekleine/superthread-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && bun --check && node tools/check-build.mjs",
    "dev": "vite dev --host 127.0.0.1 --port 3001 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node tools/test-worker.mjs && bun test src && node tools/check-fonts.mjs && python3 -I ../../packages/superthread/scripts/texture/build.py verify --dir public/texture"
  },
  "dependencies": {
    "@base-ui/react": "~1.8.0",
