    "@tanstack/react-start": "~1.168.60",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "cmdk": "~1.1.1",
    "cn": "~0.4.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-resizable-panels": "~4.14.1",
    "sonner": "~2.0.8",
    "tailwind-merge": "~3.7.0",
    "tailwindcss": "~4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "~1.62.3",
    "@happy-dom/global-registrator": "~21.0.4",
    "@types/bun": "~1.4.3",
    "@types/node": "~26.6.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~6.1.1",
    "cf": "1.0.0-beta.18",
    "shadcn": "~4.22.1",
