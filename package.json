{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "deploy": "bunx wrangler deploy",
    "dev": "bun run --filter @mauricekleine/site dev",
    "prepare": "husky",
    "test": "node apps/site/tools/test-worker.mjs"
  },
  "lint-staged": {
    "package.json": [
      "bun x sort-package-json"
    ]
  },
  "devDependencies": {
    "husky": "~9.1.7",
    "lint-staged": "~16.2.7",
    "sort-package-json": "~3.5.0"
  },
  "packageManager": "bun@1.4.2"
}
