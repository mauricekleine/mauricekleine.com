{
  "version": "alpha",
  "name": "superthread",
  "description": "maurice kleine's design system. one thread (ember) through every surface, two modes (void and paper).",
  "colors": {
    "primary": "oklch(75% 0.13 55)",
    "void-ground": "oklch(17% 0.035 275)",
    "void-ground-deep": "oklch(13% 0.03 280)",
    "void-surface": "oklch(20% 0.035 278)",
    "void-line": "oklch(30% 0.03 278)",
    "void-line-strong": "oklch(40% 0.03 278)",
    "void-ink": "oklch(94% 0.01 85)",
    "void-ink-muted": "oklch(76% 0.02 275)",
    "void-ink-dim": "oklch(66% 0.015 275)",
    "void-ink-dim-ui": "oklch(64% 0.02 275)",
    "void-thread": "oklch(75% 0.13 55)",
    "void-thread-bright": "oklch(84% 0.12 65)",
    "void-thread-ink": "oklch(13% 0.03 280)",
    "void-thread-soft": "oklch(75% 0.13 55 / 0.13)",
    "void-atmosphere-wash": "oklch(45% 0.09 300)",
    "void-atmosphere": "oklch(62% 0.12 300)",
    "void-danger": "oklch(64% 0.19 25)",
    "void-danger-soft": "oklch(64% 0.19 25 / 0.13)",
    "paper-ground": "#fbfaf7",
    "paper-ground-deep": "#fbfaf7",
    "paper-surface": "#f4f2ed",
    "paper-line": "#d9d5cc",
    "paper-line-strong": "#bdb7aa",
    "paper-ink": "#1a1a1a",
    "paper-ink-muted": "#55524c",
    "paper-ink-dim": "#6f6a62",
    "paper-ink-dim-ui": "#6f6a62",
    "paper-thread": "oklch(55% 0.13 55)",
    "paper-thread-bright": "oklch(48% 0.14 52)",
    "paper-thread-soft": "oklch(94% 0.035 60)",
    "paper-thread-ink": "#fbfaf7",
    "paper-danger": "#8e7a76",
    "paper-danger-soft": "#efe9e7",
    "atmosphere-soliton": "oklch(55% 0.11 300)",
    "atmosphere-orbit": "oklch(60% 0.10 260)",
    "atmosphere-hyperspeed": "oklch(65% 0.10 200)"
  },
  "typography": {
    "display-xl": {
      "fontFamily": "Panchang",
      "fontSize": "2.9rem",
      "fontWeight": 800,
      "lineHeight": 1.1,
      "letterSpacing": "-0.02em"
    },
    "display-lg": {
      "fontFamily": "Panchang",
      "fontSize": "1.2rem",
      "fontWeight": 600,
      "lineHeight": 1.2,
      "letterSpacing": "-0.01em"
    },
    "display-ui": {
      "fontFamily": "Panchang",
      "fontSize": "15px",
      "fontWeight": 600,
      "lineHeight": 1.3,
      "letterSpacing": "-0.015em"
    },
    "body": {
      "fontFamily": "Supreme",
      "fontSize": "1.0625rem",
      "fontWeight": 400,
      "lineHeight": 1.65
    },
    "body-strong": {
      "fontFamily": "Supreme",
      "fontSize": "1.0625rem",
      "fontWeight": 500,
      "lineHeight": 1.65
    },
    "reading": {
      "fontFamily": "Erode",
      "fontSize": "1.125rem",
      "fontWeight": 400,
      "lineHeight": 1.65
    },
    "meta": {
      "fontFamily": "Fragment Mono",
      "fontSize": "0.8rem",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "label": {
      "fontFamily": "Fragment Mono",
      "fontSize": "11px",
      "fontWeight": 400,
      "lineHeight": 1.3,
      "letterSpacing": "0.14em"
    }
  },
  "rounded": {
    "xs": "6px",
    "sm": "8px",
    "md": "12px",
    "pill": "20px",
    "full": "9999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "48px",
    "4xl": "64px",
    "measure": "42rem"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.void-thread}",
      "textColor": "{colors.void-thread-ink}",
      "typography": "{typography.body-strong}",
      "rounded": "{rounded.sm}"
    },
    "button-primary-hover": {
      "backgroundColor": "{colors.void-thread-bright}"
    },
    "card": {
      "backgroundColor": "{colors.void-surface}",
      "rounded": "{rounded.sm}",
      "padding": "{spacing.md}"
    },
    "chip": {
      "typography": "{typography.label}",
      "rounded": "{rounded.xs}"
    },
    "pill": {
      "typography": "{typography.label}",
      "rounded": "{rounded.pill}"
    }
  }
}
