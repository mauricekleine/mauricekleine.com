{
  "name": "@mauricekleine/superthread",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "exports": {
    "./theme.css": "./dist/superthread.css",
    "./v2/theme.css": "./dist/v2/superthread.css",
    "./v2/plain.css": "./dist/v2/superthread-plain.css",
    "./v2/tokens": "./items/lib/tokens.ts",
    "./v2/tokens.json": "./dist/v2/tokens.json",
    "./fleet": "./items/lib/fleet.ts",
    "./fonts": "./fonts.ts"
  },
  "scripts": {
    "build": "bun scripts/generate.ts",
    "check": "bun scripts/generate.ts --check && bun run marks check && python3 -I scripts/texture/build.py tiles --check",
    "clean-room": "bun test/clean-room/run.ts",
    "lint": "designmd lint DESIGN.md",
    "marks": "bun scripts/marks.ts",
    "registry": "bun scripts/build-registry.ts",
    "snapshot": "bun scripts/build-registry.ts --snapshot --base-url https://superthread.mauricekleine.com",
    "test": "bun test && bun --check",
    "texture": "python3 -I scripts/texture/build.py tiles",
    "upstream": "bun scripts/upstream.ts",
    "vendor": "bun scripts/vendor-master.ts"
  },
  "devDependencies": {
    "@base-ui/react": "~1.8.0",
    "@google/design.md": "0.4.0",
    "@happy-dom/global-registrator": "~21.0.4",
    "@types/bun": "~1.4.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "cmdk": "~1.1.1",
    "cn": "~0.4.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-resizable-panels": "~4.14.1",
    "shadcn": "~4.22.1",
    "sonner": "~2.0.8",
    "tailwind-merge": "~3.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  }
}
